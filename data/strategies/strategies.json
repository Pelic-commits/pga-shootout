{
  "schema_version": "1.0.0",
  "strategies": [
    {
      "identifier": "par3",
      "version": "1.0.0",
      "user_name": "Sac Par 3",
      "description": "Atteindre directement le green, puis terminer depuis le green.",
      "origin": "bundled",
      "bag_size": 5,
      "uncertainty_policy": "report_indeterminate",
      "expected_active_roles": ["attack_club", "putter"],
      "available_support_clubs": 3,
      "sequence": [
        {
          "identifier": "attack",
          "name": "Atteindre le green",
          "active_role": "attack_club",
          "function": {"identifier": "reach_target_zone", "parameters": {"target_zone": "green"}},
          "context": {"values": {"terrain": "tee"}, "required_data": []},
          "requirements": [
            {
              "identifier": "reach_green",
              "subject": {"kind": "shot_outcome", "field": "target_zone"},
              "operator": "eq",
              "expected": "green",
              "description": "Le coup doit atteindre le green.",
              "required_data": ["validated_carry_model", "target_distance"]
            }
          ],
          "local_objectives": [
            {
              "priority": 1,
              "operation": "pareto",
              "metric": "all_comparable_metrics",
              "description": "Conserver les compromis objectifs entre toutes les métriques comparables."
            }
          ]
        },
        {
          "identifier": "putt",
          "name": "Terminer depuis le green",
          "active_role": "putter",
          "function": {"identifier": "finish", "parameters": {"start_zone": "green"}},
          "context": {"values": {"terrain": "green"}, "required_data": []},
          "requirements": [
            {
              "identifier": "finish_hole",
              "subject": {"kind": "shot_outcome", "field": "hole_result"},
              "operator": "eq",
              "expected": "holed",
              "description": "Le coup doit terminer le trou.",
              "required_data": ["validated_putt_model"]
            }
          ],
          "local_objectives": [
            {
              "priority": 1,
              "operation": "pareto",
              "metric": "all_comparable_metrics",
              "description": "Conserver les compromis objectifs entre toutes les métriques comparables."
            }
          ]
        }
      ]
    },
