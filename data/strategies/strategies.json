        {
          "step_id": "drive",
          "context_updates": {"wind_relation": "head_or_crosswind"},
          "required_context_data": ["validated_wind_direction_context"],
          "add_requirements": [],
          "add_local_objectives": [
            {
              "priority": 1,
              "operation": "maximize",
